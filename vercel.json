{
    "rewrites": [
        {
            "source": "/robots.txt",
            "destination": "/public/robots.txt"
        },
        {
            "source": "/css/(.*)",
            "destination": "/public/css/$1"
        },
        {
            "source": "/js/(.*)",
            "destination": "/public/js/$1"
        },
        {
            "source": "/images/(.*)",
            "destination": "/public/images/$1"
        },
        {
            "source": "/login",
            "destination": "/public/login.html"
        },
        {
            "source": "/dashboard",
            "destination": "/public/dashboard.html"
        },
        {
            "source": "/(.*)",
            "destination": "/public/index.html"
        }
    ]
}